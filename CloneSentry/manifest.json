{
  "manifest_version": 3,
  "name": "SpecterScan Supreme",
  "version": "2.1",
  "permissions": ["tabs", "storage", "scripting", "activeTab", "webNavigation"],
  "host_permissions": ["https://spectarscan.onrender.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "ui/popup.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}